# Local Docker Compose password. The web container always connects to the local db service.
POSTGRES_PASSWORD=change_me_for_local_development

# Docker Compose sets MANAZIL_ENV=development and PHOTO_STORAGE_BACKEND=local.
# Any DATABASE_URL in this file is ignored by Compose's web service.
# Production App Service settings (supply real values there, never commit them):
# MANAZIL_ENV=production
# SECRET_KEY=<unique random secret of at least 32 characters>
# DATABASE_URL=<Neon PostgreSQL URL from Neon, including sslmode=require>
# PHOTO_STORAGE_BACKEND=azure_blob
# AZURE_STORAGE_CONNECTION_STRING=<private storage credential>
# AZURE_STORAGE_CONTAINER=<existing private container>
# TRUST_PROXY_HEADERS=1  # only behind the trusted App Service proxy
# TRUSTED_HOSTS=<comma-separated App Service/custom host names>
